{
  "name": "composition-dude",
  "version": "1.0.0",
  "description": "A local product composition workbench",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "desktop:ui": "vite build --config desktop/vite.config.ts",
    "offline:build": "npm run desktop:ui && node scripts/build-offline.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "radix-ui": "1.6.7",
    "lucide-react": "1.31.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "next-themes": "0.4.6",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.13",
    "tailwindcss": "4.2.1",
    "@tailwindcss/postcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19"
  }
}
